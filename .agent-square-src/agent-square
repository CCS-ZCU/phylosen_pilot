#!/usr/bin/env python3
"""Unified, read-only thread index and SSH-friendly launcher."""

from __future__ import annotations

import argparse
import datetime as dt
import glob
import json
import os
from pathlib import Path
import shutil
import sqlite3
import subprocess
import sys
from typing import Iterable


HOME = Path.home()
DATA_DIR = HOME / ".local/share/agent-square"
INDEX = DATA_DIR / "index.sqlite"


def connect_index() -> sqlite3.Connection:
    DATA_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    db = sqlite3.connect(INDEX)
    db.row_factory = sqlite3.Row
    db.executescript(
        """
        PRAGMA journal_mode=WAL;
        CREATE TABLE IF NOT EXISTS threads (
          id TEXT PRIMARY KEY,
          source TEXT NOT NULL,
          source_id TEXT NOT NULL,
          title TEXT NOT NULL DEFAULT '',
          project TEXT NOT NULL DEFAULT '',
          cwd TEXT NOT NULL DEFAULT '',
          created_at TEXT NOT NULL DEFAULT '',
          updated_at TEXT NOT NULL DEFAULT '',
          parent_id TEXT,
          source_path TEXT NOT NULL DEFAULT '',
          resumable INTEGER NOT NULL DEFAULT 0,
          UNIQUE(source, source_id)
        );
        CREATE INDEX IF NOT EXISTS threads_updated ON threads(updated_at DESC);
        CREATE INDEX IF NOT EXISTS threads_project ON threads(project);
        CREATE VIRTUAL TABLE IF NOT EXISTS threads_fts USING fts5(
          id UNINDEXED, title, project, cwd, content='threads', content_rowid='rowid'
        );
        CREATE TRIGGER IF NOT EXISTS threads_ai AFTER INSERT ON threads BEGIN
          INSERT INTO threads_fts(rowid,id,title,project,cwd)
          VALUES (new.rowid,new.id,new.title,new.project,new.cwd);
        END;
        CREATE TRIGGER IF NOT EXISTS threads_ad AFTER DELETE ON threads BEGIN
          INSERT INTO threads_fts(threads_fts,rowid,id,title,project,cwd)
          VALUES ('delete',old.rowid,old.id,old.title,old.project,old.cwd);
        END;
        CREATE TRIGGER IF NOT EXISTS threads_au AFTER UPDATE ON threads BEGIN
          INSERT INTO threads_fts(threads_fts,rowid,id,title,project,cwd)
          VALUES ('delete',old.rowid,old.id,old.title,old.project,old.cwd);
          INSERT INTO threads_fts(rowid,id,title,project,cwd)
          VALUES (new.rowid,new.id,new.title,new.project,new.cwd);
        END;
        """
    )
    try:
        os.chmod(INDEX, 0o600)
    except OSError:
        pass
    return db


def ro_connect(path: Path) -> sqlite3.Connection:
    db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    db.row_factory = sqlite3.Row
    return db


def iso_timestamp(value: object) -> str:
    if value is None or value == "":
        return ""
    if isinstance(value, (int, float)):
        stamp = float(value)
        if stamp > 10_000_000_000:
            stamp /= 1000
        return dt.datetime.fromtimestamp(stamp, dt.timezone.utc).isoformat()
    return str(value)


def project_name(cwd: str) -> str:
    return Path(cwd).name if cwd else ""


def upsert(db: sqlite3.Connection, row: dict[str, object]) -> None:
    fields = (
        "id", "source", "source_id", "title", "project", "cwd",
        "created_at", "updated_at", "parent_id", "source_path", "resumable",
    )
    db.execute(
        f"INSERT OR REPLACE INTO threads ({','.join(fields)}) "
        f"VALUES ({','.join('?' for _ in fields)})",
        [row.get(field, "") for field in fields],
    )


def scan_codex(db: sqlite3.Connection) -> int:
    path = HOME / ".codex/state_5.sqlite"
    if not path.exists():
        return 0
    db.execute("DELETE FROM threads WHERE source='codex'")
    count = 0
    with ro_connect(path) as source:
        for row in source.execute(
            "SELECT id,title,cwd,created_at_ms,updated_at_ms,created_at,updated_at,"
            "agent_nickname FROM threads"
        ):
            title = row["title"] or row["agent_nickname"] or "Codex thread"
            cwd = row["cwd"] or ""
            upsert(db, {
                "id": f"codex:{row['id']}", "source": "codex",
                "source_id": row["id"], "title": title,
                "project": project_name(cwd), "cwd": cwd,
                "created_at": iso_timestamp(row["created_at_ms"] or row["created_at"]),
                "updated_at": iso_timestamp(row["updated_at_ms"] or row["updated_at"]),
                "source_path": str(path), "resumable": 1,
            })
            count += 1
    return count


def content_text(content: object) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        chunks = []
        for item in content:
            if isinstance(item, dict) and isinstance(item.get("text"), str):
                chunks.append(item["text"])
        return " ".join(chunks)
    return ""


def claude_metadata(path: Path) -> dict[str, object]:
    session_id = path.stem
    cwd = ""
    title = ""
    created = ""
    updated = ""
    parent_id = ""
    try:
        with path.open("r", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    continue
                session_id = event.get("sessionId") or session_id
                cwd = event.get("cwd") or cwd
                stamp = event.get("timestamp") or ""
                created = created or stamp
                updated = stamp or updated
                parent_id = event.get("parentUuid") or parent_id
                if not title and event.get("type") == "user":
                    message = event.get("message") or {}
                    text = content_text(message.get("content") if isinstance(message, dict) else message)
                    text = " ".join(text.split())
                    if text and not text.startswith("<"):
                        title = text[:100]
    except OSError:
        pass
    if not updated:
        updated = iso_timestamp(path.stat().st_mtime)
    return {
        "id": f"claude:{session_id}", "source": "claude",
        "source_id": session_id, "title": title or "Claude thread",
        "project": project_name(cwd), "cwd": cwd,
        "created_at": created, "updated_at": updated,
        "parent_id": parent_id, "source_path": str(path), "resumable": 1,
    }


def scan_claude(db: sqlite3.Connection) -> int:
    root = HOME / ".claude/projects"
    if not root.exists():
        return 0
    db.execute("DELETE FROM threads WHERE source='claude'")
    count = 0
    for path in root.glob("**/*.jsonl"):
        upsert(db, claude_metadata(path))
        count += 1
    return count


def scan_opencode(db: sqlite3.Connection) -> int:
    path = HOME / ".local/share/opencode/opencode.db"
    if not path.exists():
        return 0
    db.execute("DELETE FROM threads WHERE source='opencode'")
    count = 0
    with ro_connect(path) as source:
        for row in source.execute(
            "SELECT id,title,directory,parent_id,time_created,time_updated FROM session"
        ):
            cwd = row["directory"] or ""
            upsert(db, {
                "id": f"opencode:{row['id']}", "source": "opencode",
                "source_id": row["id"], "title": row["title"] or "OpenCode thread",
                "project": project_name(cwd), "cwd": cwd,
                "created_at": iso_timestamp(row["time_created"]),
                "updated_at": iso_timestamp(row["time_updated"]),
                "parent_id": row["parent_id"] or "", "source_path": str(path),
                "resumable": 1,
            })
            count += 1
    return count


def scan_copilot(db: sqlite3.Connection) -> int:
    path = HOME / ".vscode-server/data/User/globalStorage/github.copilot-chat/session-store.db"
    if not path.exists():
        return 0
    db.execute("DELETE FROM threads WHERE source='copilot'")
    count = 0
    with ro_connect(path) as source:
        for row in source.execute(
            "SELECT id,cwd,summary,agent_name,created_at,updated_at FROM sessions"
        ):
            cwd = row["cwd"] or ""
            title = row["summary"] or row["agent_name"] or "Copilot thread"
            upsert(db, {
                "id": f"copilot:{row['id']}", "source": "copilot",
                "source_id": row["id"], "title": title,
                "project": project_name(cwd), "cwd": cwd,
                "created_at": iso_timestamp(row["created_at"]),
                "updated_at": iso_timestamp(row["updated_at"]),
                "source_path": str(path), "resumable": 0,
            })
            count += 1
    return count


def scan(db: sqlite3.Connection, quiet: bool = False) -> dict[str, int]:
    counts = {
        "codex": scan_codex(db),
        "claude": scan_claude(db),
        "opencode": scan_opencode(db),
        "copilot": scan_copilot(db),
    }
    db.commit()
    if not quiet:
        print("Indexed " + ", ".join(f"{name}={count}" for name, count in counts.items()))
    return counts


def display_time(value: str) -> str:
    if not value:
        return "-"
    return value.replace("T", " ")[:16]


def query_threads(
    db: sqlite3.Connection, *, source: str | None = None,
    project: str | None = None, search: str | None = None, limit: int = 30,
) -> list[sqlite3.Row]:
    args: list[object] = []
    if search:
        sql = "SELECT t.* FROM threads t JOIN threads_fts f ON f.rowid=t.rowid WHERE threads_fts MATCH ?"
        args.append('"' + search.replace('"', '""') + '"')
    else:
        sql = "SELECT * FROM threads WHERE 1=1"
    if source:
        sql += " AND source=?"
        args.append(source)
    if project:
        sql += " AND (project LIKE ? OR cwd LIKE ?)"
        args.extend([f"%{project}%", f"%{project}%"])
    sql += " ORDER BY updated_at DESC LIMIT ?"
    args.append(limit)
    return list(db.execute(sql, args))


def print_rows(rows: Iterable[sqlite3.Row], numbered: bool = False) -> None:
    rows = list(rows)
    if not rows:
        print("No threads found.")
        return
    for index, row in enumerate(rows, 1):
        prefix = f"{index:>2}. " if numbered else ""
        marker = " " if row["resumable"] else "*"
        short_id = row["source_id"][:8]
        title = " ".join((row["title"] or "").split())[:76]
        print(
            f"{prefix}{display_time(row['updated_at']):16} "
            f"{row['source']:<8}{marker} {row['project']:<18.18} {short_id:<8}  {title}"
        )
    if any(not row["resumable"] for row in rows):
        print("* indexed, but this CLI cannot resume it directly")


def resolve(db: sqlite3.Connection, reference: str) -> sqlite3.Row:
    rows = list(db.execute(
        "SELECT * FROM threads WHERE id=? OR source_id=? OR id LIKE ? OR source_id LIKE ?",
        (reference, reference, f"%:{reference}%", f"{reference}%"),
    ))
    unique = {row["id"]: row for row in rows}
    if not unique:
        raise SystemExit(f"Unknown thread: {reference}")
    if len(unique) > 1:
        print_rows(unique.values())
        raise SystemExit("Ambiguous thread reference; use a longer ID or source:id.")
    return next(iter(unique.values()))


def executable(name: str) -> str:
    found = shutil.which(name)
    if found:
        return found
    fallbacks = {
        "codex": sorted(glob.glob(str(HOME / ".vscode-server/extensions/openai.chatgpt-*/bin/linux-*/codex"))),
        "claude": [str(HOME / ".local/bin/claude")],
        "opencode": [str(HOME / ".opencode/bin/opencode")],
    }.get(name, [])
    for candidate in reversed(fallbacks):
        if Path(candidate).is_file() and os.access(candidate, os.X_OK):
            return candidate
    raise SystemExit(f"Cannot find executable: {name}")


def resume(row: sqlite3.Row) -> None:
    if not row["resumable"]:
        raise SystemExit(f"{row['source']} thread is indexed but has no terminal resume adapter.")
    cwd = Path(row["cwd"] or HOME)
    if not cwd.is_dir():
        print(f"Warning: stored cwd does not exist: {cwd}; using {HOME}", file=sys.stderr)
        cwd = HOME
    os.chdir(cwd)
    sid = row["source_id"]
    if row["source"] == "codex":
        cmd = [executable("codex"), "resume", sid, "--no-alt-screen"]
    elif row["source"] == "claude":
        cmd = [executable("claude"), "--resume", sid]
    elif row["source"] == "opencode":
        cmd = [executable("opencode"), "--session", sid]
    else:
        raise SystemExit(f"No resume adapter for {row['source']}")
    print(f"Opening {row['source']} thread in {cwd} ...")
    os.execv(cmd[0], cmd)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="agent-square", description=__doc__)
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("scan", help="refresh the local metadata index")
    for name in ("list", "recent"):
        item = sub.add_parser(name, help="list recent threads")
        item.add_argument("--source", choices=("codex", "claude", "opencode", "copilot"))
        item.add_argument("--project")
        item.add_argument("--limit", type=int, default=30)
    search = sub.add_parser("search", help="search titles and project paths")
    search.add_argument("query")
    search.add_argument("--limit", type=int, default=50)
    show = sub.add_parser("show", help="show thread metadata")
    show.add_argument("thread")
    open_cmd = sub.add_parser("open", aliases=["resume"], help="resume a terminal thread")
    open_cmd.add_argument("thread")
    pick = sub.add_parser("pick", help="choose a recent thread interactively")
    pick.add_argument("--source", choices=("codex", "claude", "opencode", "copilot"))
    pick.add_argument("--project")
    pick.add_argument("--limit", type=int, default=30)
    return parser


def main() -> None:
    args = build_parser().parse_args()
    db = connect_index()
    if args.command == "scan":
        scan(db)
        return
    scan(db, quiet=True)
    if args.command in ("list", "recent"):
        print_rows(query_threads(db, source=args.source, project=args.project, limit=args.limit))
    elif args.command == "search":
        print_rows(query_threads(db, search=args.query, limit=args.limit))
    elif args.command == "show":
        print(json.dumps(dict(resolve(db, args.thread)), indent=2, ensure_ascii=False))
    elif args.command in ("open", "resume"):
        resume(resolve(db, args.thread))
    else:
        rows = query_threads(
            db, source=getattr(args, "source", None),
            project=getattr(args, "project", None), limit=getattr(args, "limit", 30),
        )
        print_rows(rows, numbered=True)
        if not rows or not sys.stdin.isatty():
            return
        choice = input("\nOpen number (Enter to quit): ").strip()
        if not choice:
            return
        try:
            row = rows[int(choice) - 1]
        except (ValueError, IndexError):
            raise SystemExit("Invalid selection.")
        resume(row)


if __name__ == "__main__":
    main()
